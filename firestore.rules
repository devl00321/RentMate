rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.verified == false
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 500));
      allow update: if (isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'verified', 'ratingAvg', 'ratingCount', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 500)))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified'])
          && request.resource.data.verified is bool);
      allow delete: if false;
    }

    function isValidListing(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 80
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 60
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 5
        && data.dailyPaise is int && data.dailyPaise >= 100
        && data.depositPaise is int && data.depositPaise >= 0
        && data.availability is list && data.availability.size() >= 1 && data.availability.size() <= 20
        && data.status in ['active', 'paused', 'removed'];
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && isValidListing(request.resource.data);
      allow update: if (isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt'])
        && isValidListing(request.resource.data))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'paused', 'removed']);
      allow delete: if false;

      match /bookedDays/{dayStr} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.bookingId is string
          && (request.resource.data.ownerId == request.auth.uid
              || request.resource.data.renterId == request.auth.uid)
          && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.listingId == listingId
          && (get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.renterId == request.auth.uid);
        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.ownerId == request.auth.uid
              || resource.data.renterId == request.auth.uid
              || isAdmin());
      }
    }

    function isBookingParty(data) {
      return isSignedIn() && (data.ownerId == request.auth.uid || data.renterId == request.auth.uid);
    }

    function isValidBookingTransition(from, to, data) {
      return (from == 'Requested' && to in ['Negotiating', 'Accepted', 'Cancelled'])
        || (from == 'Negotiating' && to in ['Accepted', 'Cancelled'])
        || (from == 'Accepted' && to in ['Paid', 'Cancelled'])
        || (from == 'Paid' && to in ['Handed Over', 'Cancelled', 'Disputed'])
        || (from == 'Handed Over' && to in ['Returned', 'Disputed'])
        || (from == 'Returned' && to in ['Completed', 'Disputed'])
        || (from == 'Disputed' && to in ['Completed', 'Cancelled'] && isAdmin())
        || (from == to);
    }

    match /bookings/{bookingId} {
      allow read: if isBookingParty(resource.data) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.renterId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'Requested'
        && request.resource.data.depositState == 'none'
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.endDate > request.resource.data.startDate;
      allow update: if (isBookingParty(resource.data) || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['listingId', 'ownerId', 'renterId', 'createdAt'])
        && isValidBookingTransition(resource.data.status, request.resource.data.status, request.resource.data)
        && (!(resource.data.status in ['Accepted', 'Paid', 'Handed Over', 'Returned', 'Completed'])
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['terms', 'amounts', 'startDate', 'endDate']));
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid
              || isAdmin());
        allow create: if isSignedIn()
          && request.resource.data.actorId == request.auth.uid
          && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid
              || isAdmin());
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid
              || isAdmin());
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/bookings/$(bookingId)).data.renterId == request.auth.uid)
          && request.resource.data.type in ['text', 'offer', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && (request.resource.data.type != 'offer'
              || (request.resource.data.offer is map
                  && request.resource.data.offer.dailyPaise is int
                  && request.resource.data.offer.dailyPaise >= 100
                  && request.resource.data.offer.depositPaise is int
                  && request.resource.data.offer.depositPaise >= 0
                  && request.resource.data.offer.pickupTime is string
                  && request.resource.data.offer.pickupTime.size() > 0
                  && request.resource.data.offer.pickupTime.size() <= 20));
        allow update, delete: if false;
      }
    }

    // Default deny for everything else until later milestones
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
